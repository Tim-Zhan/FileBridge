<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 捆绑安装官方 Tailscale App 需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ 包可见性：声明我们要查询所有能打开文件的第三方应用（WPS/Office等），
         否则 queryIntentActivities 查不到它们，选择器会为空 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <!-- 查询官方 Tailscale App 是否已安装（组网按钮跳转用） -->
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FileBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowseActivity"
            android:exported="false" />

        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
